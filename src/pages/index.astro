---
import Events from "@components/events/events.astro";
import Layout from "../layouts/layout.astro";
import type { Page } from "@lib/types";
import { getAllDocs } from "@lib/payloadcms";

const pages = await getAllDocs("pages", {});
---

<Layout>
	<h1 class="text-2xl text-center md:text-4xl m-2">Index</h1>
	{pages.map((page: Page) => <a href={`/${page.slug}`}>{page.title}</a>)}
	<Events />
</Layout>
