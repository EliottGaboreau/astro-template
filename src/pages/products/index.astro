---
import Layout from "../../layouts/layout.astro";
import ListItem from "@components/ecommerce/list_item.astro";
import { getAllDocs } from "@lib/payloadcms";
import type { Product } from "@lib/types";

const products = await getAllDocs("products", {});
---

<Layout>
	<h1 class="text-2xl text-center md:text-4xl m-2">Products</h1>
	{products.map((product: Product) => <ListItem product={product} />)}
</Layout>
